# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=replace_with_your_key
# Pick a model your provider currently lists as supporting tool/function calling.
MODEL=replace_with_current_tool_calling_model
# Optional overrides
# LLM_BASE_URL=https://api.groq.com/openai/v1
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # or "hash" for offline tests
# MAX_STEPS=8
# API_URL=http://localhost:8000    # makes the Streamlit UI call FastAPI instead of running in-process
